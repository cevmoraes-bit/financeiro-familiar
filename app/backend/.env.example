# === Banco de dados (Supabase Postgres) ===
# Pegue em: Supabase > Project Settings > Database > Connection string (modo "Transaction pooler" recomendado)
DATABASE_URL=postgresql+asyncpg://postgres:[SUA-SENHA]@aws-0-xxxx.pooler.supabase.com:6543/postgres

# === Autenticação JWT (tokens da aplicação) ===
JWT_SECRET_KEY=troque-por-um-valor-aleatorio-longo
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === OIDC (login externo, se aplicável) ===
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email

# === URLs da aplicação ===
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# === Admin ===
ADMIN_USER_ID=

# === Integrações de IA (se usadas no projeto) ===
APP_AI_BASE_URL=
APP_AI_KEY=
OPAPI_KEY=
OSS_API_KEY=
OSS_SERVICE_URL=

# === Stripe (pagamentos, se usado) ===
STRIPE_SECRET_KEY=

# === Outros ===
DEBUG=false
